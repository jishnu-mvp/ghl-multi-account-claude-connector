# Secrets — never commit
.env
*.key
*.pem

# Personal/local Claude Code settings — not shared
.claude/settings.local.json
# NOTE: .mcp.json IS committed on purpose — it must only ever contain the
# ${GHL_PIT_TOKEN} / ${GHL_LOCATION_ID} placeholders, never a real pit- token.
# Real tokens live in .env.

# Local GHL exports / backups produced by the helper scripts
contact-*.json
contacts-*.json
opportunity-*.json
opportunities-*.json
conversation-*.json
appointment-*.json
backup*.json
export-*.json

# CRM data does not belong in this tooling repo (it contains PII)
*.csv
*.pdf
*.xlsx
run-*.json
test-*.json

# OS / editor junk
.DS_Store
Thumbs.db
*.swp

# Local scratch/build tooling (e.g. node_modules from generating docs) — not part of the repo
scratch/
node_modules/

# Hosted server state: OAuth clients, grants and ENCRYPTED GoHighLevel credentials.
# Never commit it — it is other people's access to their CRMs.
remote/data/
data/
*.encryption-key
.encryption-key

# Deploy-tool working directories. The committed config (netlify.toml, vercel.json) is the
# source of truth; these are local caches the CLIs create.
.netlify/
.vercel/
