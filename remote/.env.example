# Hosted GoHighLevel MCP server — configuration.
# Copy to remote/.env and fill in. NEVER commit the filled-in file.

# --- REQUIRED ---------------------------------------------------------------------
# The exact HTTPS origin clients will use. This is the OAuth issuer and the audience every
# access token is bound to, so it must match what people type, with no trailing slash.
# Clients then add the connector as  <PUBLIC_URL>/mcp
PUBLIC_URL=https://ghl.example.com

# Encrypts stored GoHighLevel credentials (AES-256-GCM). 32 bytes of hex, or a long
# passphrase. Generate one:  openssl rand -hex 32
# Losing or changing it makes every stored connection unreadable — everyone must reconnect.
ENCRYPTION_KEY=

# --- HighLevel marketplace app (REQUIRED) -----------------------------------------
# This is how people sign in: their own HighLevel email and password, on HighLevel's site,
# then they tick the sub-accounts to share — repeatable, so one connection can span several
# HighLevel agencies. HighLevel has no dynamic registration, so the app is created once by
# you. Add this redirect URL to it:
#   <PUBLIC_URL>/highlevel/callback
# Full walkthrough: PUBLISHING.md. Without these, nobody can connect at all — unless you
# turn on ALLOW_TOKEN_CONNECT below.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=

# --- The Private Integration Token route (off by default) -------------------------
# true = the consent screen also accepts a pasted pit-… token. Useful for a smoke test
# before the marketplace app exists, or for a sub-account whose owner prefers a scoped token
# to signing in. Leave it off if you want everyone on their own HighLevel login.
ALLOW_TOKEN_CONNECT=false

# --- Where state is kept ----------------------------------------------------------
# file  = JSON files under DATA_DIR. Needs a persistent disk. Right for a VPS or a container
#         with a volume, and the default.
# redis = Upstash REST. REQUIRED on serverless (Vercel, Lambda, Cloud Run), where the disk is
#         wiped between invocations, and needed for more than one replica.
# auto  = redis when connection details are present, otherwise file.
STORAGE=auto

# Only for STORAGE=redis. Vercel's Upstash Marketplace integration injects
# KV_REST_API_URL / KV_REST_API_TOKEN instead and those are read automatically, so on Vercel
# you can leave these blank.
REDIS_REST_URL=
REDIS_REST_TOKEN=

# --- Serving ----------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
DATA_DIR=/data
# Read the client IP from X-Forwarded-For. Correct behind a reverse proxy or platform
# router; set to false if the server is exposed directly, or rate limiting can be spoofed.
TRUST_PROXY=true

# --- Branding shown on the consent screen -----------------------------------------
BRAND_NAME=GoHighLevel Connector
BRAND_OPERATOR=
SUPPORT_EMAIL=
PRIVACY_URL=
TERMS_URL=

# --- Access control ---------------------------------------------------------------
# Leave blank for a connector anyone may connect their own CRM to. Set a phrase to gate it
# to your own team or clients — they must type it on the consent screen.
SIGNUP_PASSCODE=

# Restrict which hosts may be used as OAuth redirect targets, e.g. claude.ai,claude.com.
# Blank allows any HTTPS redirect (plus loopback), which is what public MCP clients need.
ALLOWED_REDIRECT_HOSTS=

# Dynamic client registration is how MCP clients get a client_id with no human involved.
# Turning it off means pre-registering every client by hand.
ALLOW_DYNAMIC_REGISTRATION=true

# --- Tuning -----------------------------------------------------------------------
# 'core' exposes 32 tools instead of 98, for clients where tool-schema size matters.
GHL_MCP_TOOLSET=full
ACCESS_TOKEN_TTL_MS=3600000
REFRESH_TOKEN_TTL_MS=2592000000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_MCP_MAX=240
