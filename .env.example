# GoHighLevel (HighLevel / LeadConnector) connection for Claude Code helper scripts + skill.
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
#
# NOTE: none of this is needed for the `ghl` MCP server (mcp-server/) — there you just log in
# in your browser (ask Claude to "log in to my GoHighLevel account", or run
# `node mcp-server/server.js --login`) and the credential is stored in ~/.ghl-mcp/, outside
# this repo. Fill this file in for the /ghl helper scripts, the leadconnector MCP, scheduled
# jobs, and cloud/web sessions where a browser login cannot work.

# --- REQUIRED: API v2 access via a Private Integration Token ---------------------
# Your PERSONAL Private Integration Token (PIT). It starts with `pit-`.
# In HighLevel: Settings → Other Settings → Private Integrations → Create new Integration,
# tick the scopes you need, then copy the token — it is shown ONCE and cannot be retrieved later.
# Sent as the `Authorization: Bearer <token>` header. Personal — never share or commit.
GHL_PIT_TOKEN=

# The sub-account (location) this token belongs to.
# In HighLevel: Settings → Business Profile → Location ID (also visible in the URL).
GHL_LOCATION_ID=

# --- Defaults: only change if you know you need to -------------------------------
# API v2 base URL. The helper scripts append the endpoint path.
GHL_API_BASE_URL=https://services.leadconnectorhq.com

# API version header. Every API v2 request must send `Version: <this>`.
# 2021-07-28 is current for most endpoints; a few legacy ones want 2021-04-15.
GHL_API_VERSION=2021-07-28

# --- Agency level (optional) -----------------------------------------------------
# Only needed for company/agency-scoped endpoints (e.g. listing sub-accounts, snapshots).
# Most agency endpoints require an AGENCY-level PIT or a full OAuth app — a sub-account
# PIT will return 401/403 on them. Leave blank if you only work inside one sub-account.
GHL_COMPANY_ID=

# --- Additional sub-accounts (optional) ------------------------------------------
# Working with more than one GHL sub-account in the same session? Add each extra one's
# token/location here with a unique suffix, then register that suffix as an alias in
# accounts.conf (see that file for the exact format). The two lines above (no suffix) are
# always the default account — nothing about them changes.
#
# Example second account "clienta":
#   GHL_PIT_TOKEN_CLIENTA=pit-...
#   GHL_LOCATION_ID_CLIENTA=...

# --- MCP (optional; only needed for the HighLevel MCP server in .mcp.json) -------
# The official HighLevel MCP endpoint for Claude. Leave as-is unless HighLevel changes it.
GHL_MCP_URL=https://services.leadconnectorhq.com/mcp/anthropic/v2

# The MCP authenticates with the SAME Private Integration Token as the API
# (`Authorization: Bearer ${GHL_PIT_TOKEN}` + `locationId: ${GHL_LOCATION_ID}`),
# so there is no separate MCP token to set. Filling in GHL_PIT_TOKEN and
# GHL_LOCATION_ID above is enough for both channels.
