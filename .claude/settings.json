{
    "permissions": {
    "allow": [
      "mcp__ghl__ghl_delete_event",
      "mcp__ghl__ghl_set_opportunity_status",
      "mcp__ghl__ghl_update_appointment",
      "mcp__ghl__ghl_create_appointment",
      "mcp__ghl__ghl_update_contact"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-ghl-env.js"],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-ghl-env.js"],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-ghl-env.js"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
